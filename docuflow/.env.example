SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
OCR_API_KEY=your-mistral-api-key
OCR_ENDPOINT=https://api.mistral.ai/v1/ocr
OCR_PROVIDER=mistral
LLM_API_KEY=your-llm-api-key
LLM_PROVIDER=openai
SEARCH_API_KEY=change-me-to-a-long-random-search-key

# Optional. Defaults are used if unset so a deployed app does not crash.
# Maximum upload size in megabytes (POST /upload). Default: 10
MAX_UPLOAD_MB=10
# Uploads allowed per IP per minute. Integer or "10/minute". Default: 10
UPLOAD_RATE_LIMIT=10
